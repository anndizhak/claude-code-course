{
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Read|Grep",
          "hooks": [
            {
              "type": "command",
              "command": "node ./hooks/read_hook.js"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Write|Edit|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "node ./hooks/post_edit_hook.js"
            }
          ]
        }
      ]
    }
  }